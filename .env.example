# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Authentication Config (Google OAuth Login)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# System SMTP Email Config (e.g., Gmail App Password or custom SMTP provider)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="hugoenglishclub@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="Hugo Award 2026 <hugoenglishclub@gmail.com>"

# Bật/tắt tính năng cho phép vote lại (true: cho phép vote lại, false hoặc để trống: cấm vote lại)
VITE_ALLOW_REVOTE="true"
